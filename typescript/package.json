{
  "name": "@hpsilab/sdk",
  "version": "0.2.0",
  "description": "Official TypeScript SDK for the HPSILab quantitative finance API — options analytics, IV surface, Monte Carlo simulation, AI predictions, and pre-trade risk scans.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests examples"
  },
  "keywords": [
    "hpsilab",
    "quant-finance",
    "quantitative-finance",
    "options-analytics",
    "implied-volatility",
    "monte-carlo",
    "stock-analysis",
    "sdk",
    "rest-api"
  ],
  "license": "MIT",
  "author": "HPSILab",
  "homepage": "https://hpsilab.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haiyunsky/hpsilab-mcp-sdk.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/haiyunsky/hpsilab-mcp-sdk/issues"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.13.0",
    "@types/node": "^20.16.0",
    "eslint": "^9.13.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^2.1.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
